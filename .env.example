# 服务监听配置
PORT=3780
HOST=127.0.0.1
DATA_DIR=./data
# 若部署在子路径（如 https://withkeya.com/cutsheet/），配置 COOKIE_PATH=/cutsheet/
BASE_PATH=
COOKIE_PATH=/

# OpenAI 接口配置（默认 gpt-6.2-sol + High 思考强度）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.2-sol
OPENAI_REASONING_EFFORT=high
# 可选协议: responses (推荐，支持 GPT-6.2 完整推理与结构化输出) | chat_completions
OPENAI_PROTOCOL=responses

# Google Gemini 接口配置（默认 gemini-4-neon + High 思考强度）
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-4-neon
GEMINI_THINKING_LEVEL=high
# 可选协议: generate_content (推荐，通用 REST) | interactions (Google Interactions API)
GEMINI_PROTOCOL=generate_content

# 长思考请求超时（毫秒，默认 15 分钟）
REQUEST_TIMEOUT_MS=900000
